# páginas reais baixadas pelos exemplos (grandes, e regeneráveis)
pagina.html
pagina.css
wa*.html
# As paginas reais que os exemplos abrem: bundles de CDN mais um script de app,
# centenas de KB cada e reproduziveis a qualquer momento. Ficam ao lado do
# `pagina.html` acima pela mesma razao — sao entrada de uma medicao, nao fonte.
react-*.html
preact-app.html
google.html
google.css

# As reguas que o `medir.sh` escreve: "<ficheiro> <1|0>" por linha, uma por
# medicao. Guarda-se a do ultimo commit para a comparacao POR FICHEIRO da
# proxima, e as anteriores nao servem para nada — cinquenta e duas tinham-se
# acumulado na raiz antes desta linha existir.
*-suite.txt
wa*.css
wa-raw.bin

# perfil e saídas do harness de paridade (regeneráveis, e o perfil do Chrome
# tem ficheiros que o git nem consegue ler)
scripts/parity/out/
# PNGs de captura da janela: artefactos de diagnóstico, nunca entrada de nada.
scripts/captura/out/

# saídas de medição (regeneráveis)
scripts/parity/out*/
scripts/parity/pagina.combinada.html
paridade/
# Páginas COMBINADAS do harness de paridade: são geradas por `scripts/parity/run.sh`
# a partir do par HTML/CSS, pesam megabytes e mudam a cada corrida. O que se
# versiona é o gerador, não a saída dele.
scripts/parity/*.combinada.html

# A suite de testes do proprio Node, clonada para medir as libs node: contra a
# regua que o Bun usa. Milhares de ficheiros de outro repositorio: o que se
# versiona e o que os corre, nunca eles. Diretorio com ponto de proposito — e
# assim que o walker do `rts test` o ignora, em vez de o contar como corpus.
.node-suite/
.claude/worktrees/
# Locks cooperativos entre agentes que partilham esta arvore
# (scripts/claude_lock.py). Sao estado de uma sessao, nunca do repositorio.
.claude/locks/

# Regua de pintura: PNG regeneraveis (tests/css/pintura), grandes e nao versionados
tests/css/pintura/
